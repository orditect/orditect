# Copy this file to .env and fill in your values. Never commit .env.

# OpenAI-compatible endpoint (Ollama / vLLM / LM Studio / OpenAI)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama            # any non-empty string for local servers; real key for OpenAI
LLM_MODEL=qwen2.5:7b          # model name as the endpoint expects

# Redis hot path
REDIS_URL=redis://localhost:6379/0

# Governance knobs (optional)
LLM_SEM_LIMIT=30              # concurrent LLM calls
BUDGET_MAX_UNITS=100000       # token budget for the whole run